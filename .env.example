# ==== Home Assistant ====
HA_URL=http://192.168.1.50:8123
HA_USERNAME=your-ha-user
HA_PASSWORD=your-ha-password
# 长效令牌（可用 services/music-fetcher/ha_mint_token.py 铸造）
HA_ACCESS_TOKEN=
HA_REFRESH_TOKEN=
HA_CLIENT_ID=http://192.168.1.50:8123/

# ==== Music Assistant ====
MA_URL=http://127.0.0.1:8095
MA_USERNAME=your-ma-user
MA_PASSWORD=your-ma-password
# 长效令牌（注意变量名是 MA_LONG_TOKEN）
MA_LONG_TOKEN=

# ==== 语音服务 ====
STT_URL=http://127.0.0.1:8100

# ==== LLM 供应商（OpenAI 兼容协议，可换任意供应商）====
LLM_API_KEY=your-llm-api-key
LLM_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 备用：智谱 GLM
ZHIPU_API_KEY=
ZHIPU_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash
